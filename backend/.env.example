# Application Operational Mode ("live" or "mock")
DATA_MODE=mock

# OpenAlex Research Papers API Configuration
OPENALEX_API_KEY=your_openalex_api_key_here
OPENALEX_MAX_RESULTS=50
OPENALEX_TIMEOUT_SECONDS=30

# European Patent Office (EPO) OPS API Configuration
EPO_CONSUMER_KEY=your_epo_consumer_key_here
EPO_CONSUMER_SECRET=your_epo_consumer_secret_here
EPO_TIMEOUT_SECONDS=30

# LLM Provider Configuration ("mock" or "openai" or "anthropic")
LLM_PROVIDER=mock
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here

# Pipeline Retrieval & Ranking Thresholds
PAPER_CANDIDATE_LIMIT=50
PATENT_CANDIDATE_LIMIT=50
FINAL_TOP_K=10
RELEVANCE_THRESHOLD=0.3
BM25_WEIGHT=0.5
SEMANTIC_WEIGHT=0.5
